{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "lint": "eslint . --ext .ts",
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts"
  },
  "dependencies": {
    "@clerk/backend": "^1.16.0",
    "@hono/node-server": "^1.13.0",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.20",
    "postgres": "^3.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^9.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
