# Backend configuration.
# Copy this file to .env and replace every required blank with a value.

# PostgreSQL. Local development can use a local instance, for example
# postgresql://postgres:[PASSWORD]@localhost:5432/[DATABASE]
# Supabase: Project Settings > Database > Connect.
# Use the Session Pooler URL for the running API. Use the Direct connection URL
# when running `npm run db:migrate` if your network supports direct connections.
# Keep the full `postgresql://...` URL, including SSL/query parameters. URL-encode
# special characters in the database password.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DATABASE-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require

# Clerk: Dashboard > API keys. The secret key must never be shared with the frontend.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Free LLM for intent parsing, via any OpenAI-compatible chat completions API.
# Option A (default): Google Gemini free tier. Create a key at https://aistudio.google.com/apikey
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL_FAST=gemini-3.8-flash
# Option B: Groq free tier (https://console.groq.com/keys)
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL_FAST=llama-3.3-70b-versatile
# Option C: local Ollama (no key; run `ollama pull llama3.1`)
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL_FAST=llama3.1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Leave blank for local Ollama.
LLM_API_KEY=
LLM_MODEL_FAST=

# Photon Beta (2.0). Required only when CHANNEL=photon.
# Create a project API key with project:read and project:write permissions.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# The pho_usr_... ID of the sender/line configured in your Photon Beta project.
PHOTON_SENDER_ID=
# The sender line's E.164 phone number shown to users for linking.
PHOTON_PHONE_NUMBER=

# Use "terminal" for local development without sending messages through Photon.
# Use "photon" when the Photon Beta adapter is configured.
CHANNEL=terminal

# Optional monitoring. Leave blank to disable API Sentry (see docs/sentry.md).
SENTRY_DSN_API=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Send prompts/completions to Sentry AI Agents. Keep false outside local debugging: prompts hold private limits.
SENTRY_RECORD_LLM_IO=false
# Streams conversation text and deal terms to Sentry Logs and the AI Agents view as a live transcript.
SENTRY_CONVERSATION_LOG=true
# Mounts /demo/* routes that trigger each Sentry monitor on demand. Never enable in production.
DEMO_MODE=false

# Optional tuning; defaults shown.
TIME_SCALE=1
SEARCH_BUDGET_EXPANSIONS=200
SEARCH_BUDGET_MS=5000
NEGOTIATION_ROUNDS=3
# Optional. HTTP port (default 3000) and the allowed browser origin for CORS (default: any).
PORT=
FRONTEND_ORIGIN=
