VITE_API_URL=http://localhost:3000
# Clerk Dashboard > API keys. This is the publishable (frontend-safe) key.
VITE_CLERK_PUBLISHABLE_KEY=
# Optional. Leave blank to disable frontend Sentry (tracing, Session Replay, feedback, logs).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
# Build-time only, for source map upload. Never prefix these with VITE_.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Backend base URL. Defaults to http://localhost:3000.
VITE_API_URL=
# Set to 1 to run the UI against built-in mock data (no API or sign-in needed).
VITE_MOCK=
